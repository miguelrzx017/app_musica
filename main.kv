#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import Animation kivy.animation.Animation

# main.kv - só o VISUAL. Regras: "<NomeDaClasse>:" estiliza a classe do main.py.
# Indentação = hierarquia. 'root' = widget da regra atual; 'self' = o widget onde
# a linha está; 'app' = o MainApp (estado do player). dp()/sp() = tamanhos que
# se adaptam à densidade da tela. Tamanhos de fonte seguem o mockup.

# ---- CORES (R, G, B, opacidade) - mude aqui e vale para o app todo ----
#:set COR_CINZA (0.62, 0.64, 0.76, 1)
#:set COR_BRANCO (1, 1, 1, 1)
#:set COR_CARTAO (1, 1, 1, 0.08)
#:set COR_DESTAQUE (0.91, 0.12, 0.12, 1)
#:set COR_LINHA (1, 1, 1, 0.09)
# Estilo "vidro": branco translúcido (deixa a cor da capa aparecer por baixo) + brilho na borda
#:set COR_VIDRO (1, 1, 1, 0.09)
#:set COR_BORDA_VIDRO (1, 1, 1, 0.16)

# ======================================================================
# FONTE (DM Sans) - registrada no main.py
# ======================================================================
<Label>:
    font_name: "DMSans"

<TextInput>:
    font_name: "DMSans"

# ======================================================================
# VIDRO ("liquid glass"): preenchimento translúcido + brilho em degradê (usa a
# textura app.gradiente: transparente embaixo, opaca em cima) + borda fina,
# reflexo na borda de cima e uma luz na cor da capa na borda de baixo.
# ======================================================================
<CartaoVidro>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, .06
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.raio]
        Color:
            rgba: 1, 1, 1, .13
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.raio]
            texture: app.gradiente
        Color:
            rgba: 1, 1, 1, .2
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, self.raio
            width: dp(1)
        Color:
            rgba: 1, 1, 1, .45
        Line:
            points: self.x + self.raio, self.top - dp(.5), self.right - self.raio, self.top - dp(.5)
            width: dp(1)
        Color:
            rgba: app.cor_capa[0], app.cor_capa[1], app.cor_capa[2], .6
        Line:
            points: self.x + self.raio, self.y + dp(.5), self.right - self.raio, self.y + dp(.5)
            width: dp(1.2)

# Botão redondo. estilo: "vidro", "destaque" (vidro com aro vermelho), "cheio" ou "limpo".
<BotaoRedondo>:
    size_hint: None, None
    size: dp(46), dp(46)
    opacity: .7 if self.state == "down" else 1
    canvas.before:
        Color:
            rgba: app.cor_capa[0], app.cor_capa[1], app.cor_capa[2], (.30 if self.estilo == "destaque" else 0)
        Ellipse:
            pos: self.x - dp(5), self.y - dp(5)
            size: self.width + dp(10), self.height + dp(10)
        Color:
            rgba: 1, 1, 1, (1 if self.estilo == "cheio" else (.11 if self.estilo in ("vidro", "destaque") else 0))
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: 1, 1, 1, (.22 if self.estilo == "vidro" else 0)
        Line:
            ellipse: self.x, self.y, self.width, self.height
            width: dp(1)
        Color:
            rgba: .95, .2, .22, (.95 if self.estilo == "destaque" else 0)
        Line:
            ellipse: self.x, self.y, self.width, self.height
            width: dp(1.6)
    canvas:
        Color:
            rgba: self.tinta
        Rectangle:
            source: self.icone
            pos: self.center_x - self.tam_icone / 2, self.center_y - self.tam_icone / 2
            size: self.tam_icone, self.tam_icone

# Três pontinhos na vertical: abre o menu da música.
<BotaoMais@ButtonBehavior+Widget>:
    size_hint: None, None
    size: dp(40), dp(56)
    opacity: .6 if self.state == "down" else 1
    canvas:
        Color:
            rgba: 1, 1, 1, .6
        Ellipse:
            pos: self.center_x - dp(1.8), self.center_y + dp(5.5)
            size: dp(3.6), dp(3.6)
        Ellipse:
            pos: self.center_x - dp(1.8), self.center_y - dp(1.8)
            size: dp(3.6), dp(3.6)
        Ellipse:
            pos: self.center_x - dp(1.8), self.center_y - dp(9)
            size: dp(3.6), dp(3.6)

# ======================================================================
# FILTROS E MENU DA MÚSICA
# ======================================================================
# Pílula de vidro clicável (ativa = contorno vermelho).
<ChipVidro>:
    padding: dp(12), 0
    spacing: dp(6)
    opacity: (.45 if self.esmaecido else 1) * (.7 if self.state == "down" else 1)
    canvas.before:
        Color:
            rgba: (1, .27, .3, .26) if self.ativo else (1, 1, 1, .09)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]
        Color:
            rgba: (1, .27, .3, .8) if self.ativo else (1, 1, 1, .2)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(20)
            width: dp(1)
    Image:
        source: root.icone
        size_hint_x: None
        width: dp(16) if root.icone else 0
        opacity: 1 if root.icone else 0
        color: (1, .5, .52, 1) if root.ativo else (1, 1, 1, .85)
    Texto:
        text: root.texto
        font_name: "DMSansMedium"
        font_size: "13sp"
        halign: "center"
        valign: "middle"
        shorten: True

<LinhaAcaoMenu>:
    size_hint_y: None
    height: dp(56)
    padding: dp(16), dp(8)
    spacing: dp(14)
    opacity: .7 if self.state == "down" else 1
    canvas.before:
        Color:
            rgba: 1, 1, 1, .08
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
    Image:
        source: root.icone
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {"center_y": .5}
        color: root.tinta
    Texto:
        text: root.texto
        font_name: "DMSansMedium"
        font_size: "16sp"
        valign: "middle"

<MenuMusica>:
    size_hint: .9, None
    height: dp(164) + (dp(62) if root.do_player else 0)
    auto_dismiss: True
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, .6
    BoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(14), dp(16), dp(14)
        spacing: dp(6)
        canvas.before:
            Color:
                rgba: .09, .08, .12, .97
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(32)]
            Color:
                rgba: app.cor_capa[0], app.cor_capa[1], app.cor_capa[2], .22
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(32)]
                texture: app.gradiente
            Color:
                rgba: 1, 1, 1, .2
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, dp(32)
                width: dp(1)
            Color:
                rgba: 1, 1, 1, .45
            Line:
                points: self.x + dp(32), self.top - dp(.5), self.right - dp(32), self.top - dp(.5)
                width: dp(1)
        BoxLayout:
            size_hint_y: None
            height: dp(62)
            spacing: dp(12)
            ImagemArredondada:
                size_hint: None, None
                size: dp(56), dp(56)
                pos_hint: {"center_y": .5}
                raio: dp(14)
                source: root.capa
            BoxLayout:
                orientation: "vertical"
                Texto:
                    text: root.titulo
                    font_name: "DMSansMedium"
                    font_size: "17sp"
                    valign: "bottom"
                Texto:
                    text: root.artista
                    font_size: "13sp"
                    valign: "top"
                    color: COR_CINZA
        LinhaAcaoMenu:
            icone: "arquivos/icones/coracao_cheio.png" if root.id_musica in app.favoritos else "arquivos/icones/coracao.png"
            tinta: (1, .27, .3, 1) if root.id_musica in app.favoritos else (1, 1, 1, .9)
            texto: "Remover dos favoritos" if root.id_musica in app.favoritos else "Adicionar aos favoritos"
            on_release: root.favoritar()
        LinhaAcaoMenu:
            size_hint_y: None
            height: dp(56) if root.do_player else 0
            opacity: 1 if root.do_player else 0
            disabled: not root.do_player
            icone: "arquivos/icones/mais.png"
            texto: "Sobre o artista e a música"
            on_release: root.ver_sobre()

# ======================================================================
# PEÇAS REUTILIZÁVEIS
# ======================================================================
# "@" cria um widget novo combinando comportamentos.
<BotaoIcone@ButtonBehavior+Image>:
    opacity: .55 if self.state == "down" else 1
    size_hint: None, None
    size: dp(44), dp(44)

<ControleSegmentado>:
    padding: dp(4)
    spacing: 0
    total: max(1, len(self.children))
    canvas.before:
        Color:
            rgba: COR_VIDRO
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: COR_BORDA_VIDRO
        Line:
            width: dp(0.8)
            rounded_rectangle: self.x, self.y, self.width, self.height, self.height / 2
        # A "pílula" que desliza até a opção escolhida
        Color:
            rgba: 1, 1, 1, .22
        RoundedRectangle:
            pos: self.x + dp(4) + (self.width - dp(8)) / self.total * self.indice, self.y + dp(4)
            size: (self.width - dp(8)) / self.total, self.height - dp(8)
            radius: [(self.height - dp(8)) / 2]
        Color:
            rgba: 1, 1, 1, .32
        Line:
            width: dp(0.9)
            rounded_rectangle: self.x + dp(4) + (self.width - dp(8)) / self.total * self.indice, self.y + dp(4), (self.width - dp(8)) / self.total, self.height - dp(8), (self.height - dp(8)) / 2

<BotaoSegmentado>:
    color: 1, 1, 1, (1 if self.selecionado else .6)
    halign: "center"
    valign: "middle"
    text_size: self.size

<IconePerfil@ButtonBehavior+Widget>:
    size_hint: None, None
    size: dp(46), dp(46)
    canvas:
        Color:
            rgba: COR_CINZA
        Ellipse:
            pos: self.x + dp(2), self.y + dp(2)
            size: dp(42), dp(42)
        Color:
            rgba: COR_CARTAO
        Ellipse:
            pos: self.center_x - dp(7), self.center_y + dp(2)
            size: dp(14), dp(14)
        Ellipse:
            pos: self.center_x - dp(14), self.y + dp(5)
            size: dp(28), dp(20)
    ImagemArredondada:
        pos: root.x + dp(2), root.y + dp(2)
        size: dp(42), dp(42)
        raio: dp(21)
        source: app.foto_perfil
        opacity: 1 if app.foto_perfil else 0

<FormaDeOnda@Widget>:
    size_hint_y: None
    height: dp(76)
    canvas:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.center_x - dp(47), self.center_y - dp(18)
            size: dp(7), dp(36)
            radius: [dp(4)]
        RoundedRectangle:
            pos: self.center_x - dp(33), self.center_y - dp(29)
            size: dp(7), dp(58)
            radius: [dp(4)]
        RoundedRectangle:
            pos: self.center_x - dp(19), self.center_y - dp(38)
            size: dp(7), dp(76)
            radius: [dp(4)]
        RoundedRectangle:
            pos: self.center_x - dp(5), self.center_y - dp(25)
            size: dp(7), dp(50)
            radius: [dp(4)]
        RoundedRectangle:
            pos: self.center_x + dp(9), self.center_y - dp(17)
            size: dp(7), dp(34)
            radius: [dp(4)]
        RoundedRectangle:
            pos: self.center_x + dp(23), self.center_y - dp(29)
            size: dp(7), dp(58)
            radius: [dp(4)]
        RoundedRectangle:
            pos: self.center_x + dp(37), self.center_y - dp(38)
            size: dp(7), dp(76)
            radius: [dp(4)]
        RoundedRectangle:
            pos: self.center_x + dp(51), self.center_y - dp(18)
            size: dp(7), dp(36)
            radius: [dp(4)]

<LinhaEstatistica>:
    size_hint_y: None
    height: dp(78)
    padding: dp(6), dp(7)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: COR_VIDRO
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: COR_BORDA_VIDRO
        Line:
            width: dp(0.8)
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(14)
    Label:
        text: str(root.numero)
        size_hint_x: None
        width: dp(22)
        color: COR_CINZA
        font_size: "16sp"
    ImagemArredondada:
        size_hint: None, None
        size: dp(50), dp(50)
        pos_hint: {"center_y": .5}
        raio: dp(9)
        source: root.capa
    BoxLayout:
        orientation: "vertical"
        spacing: dp(2)
        Label:
            text: root.titulo
            font_name: "DMSansMedium"
            font_size: "15sp"
            halign: "left"
            valign: "bottom"
            text_size: self.size
            shorten: True
        Label:
            text: root.detalhe
            color: COR_CINZA
            font_size: "12sp"
            halign: "left"
            valign: "top"
            text_size: self.size
            shorten: True
    Label:
        text: root.valor
        size_hint_x: None
        width: min(dp(82), max(dp(68), root.width * .25))
        color: COR_CINZA
        font_size: "12sp"
        halign: "right"
        valign: "middle"
        text_size: self.size

<CartaoResumo>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(80)
    padding: dp(16), dp(9)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: COR_VIDRO
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: COR_BORDA_VIDRO
        Line:
            width: dp(0.8)
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(14)
    Label:
        text: root.rotulo
        color: COR_CINZA
        font_size: "13sp"
        halign: "left"
        valign: "bottom"
        text_size: self.size
    Label:
        text: root.valor
        font_name: "DMSansMedium"
        font_size: "21sp"
        halign: "left"
        valign: "top"
        text_size: self.size

# Texto de uma linha, alinhado à esquerda, com "..." se não couber.
<Texto@Label>:
    halign: "left"
    valign: "middle"
    text_size: self.size
    shorten: True
    shorten_from: "right"

# Subtítulo cinza: quebra de linha se precisar e a altura se ajusta ao texto.
<Subtitulo@Label>:
    size_hint_y: None
    height: self.texture_size[1]
    text_size: self.width, None
    halign: "left"
    color: COR_CINZA
    font_size: "11sp"

<BotaoTexto@ButtonBehavior+Label>:
    halign: "center"

<BotaoOpcao@ButtonBehavior+Label>:
    size_hint_y: None
    height: dp(50)
    halign: "left"
    valign: "middle"
    text_size: self.size
    font_size: "16sp"

# Caixa inteira clicável (usada no "Banco de dados" do menu e no "Ver mais").
<BotaoCaixa@ButtonBehavior+BoxLayout>:
    orientation: "horizontal"

# Botão redondo branco com seta para a esquerda (voltar). A área de toque é maior
# que o círculo (44dp) para ser fácil de acertar com o dedo.
# Ícone "letra": três linhas de texto desenhadas (não precisa de .png)
<BotaoLetra@ButtonBehavior+Widget>:
    size_hint: None, None
    size: dp(46), dp(46)
    canvas:
        Color:
            rgba: 1, 1, 1, (.6 if self.state == "down" else 1)
        Line:
            points: self.center_x - dp(12), self.center_y + dp(8), self.center_x + dp(12), self.center_y + dp(8)
            width: dp(1.1)
            cap: "round"
        Line:
            points: self.center_x - dp(12), self.center_y, self.center_x + dp(5), self.center_y
            width: dp(1.1)
            cap: "round"
        Line:
            points: self.center_x - dp(12), self.center_y - dp(8), self.center_x + dp(9), self.center_y - dp(8)
            width: dp(1.1)
            cap: "round"

<LinhaLetra>:
    size_hint_y: None
    text_size: self.width - dp(8), None
    height: self.texture_size[1] + dp(22)
    halign: "left"
    valign: "middle"
    font_name: "DMSansMedium"
    font_size: "26sp"
    line_height: 1.1
    color: 1, 1, 1, self.brilho

<TelaLetra>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(6), dp(16), dp(8)
        spacing: dp(6)
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            spacing: dp(10)
            BotaoVoltar:
                pos_hint: {"center_y": .5}
                on_release: app.voltar_tela()
            BoxLayout:
                orientation: "vertical"
                pos_hint: {"center_y": .5}
                Label:
                    text: root.titulo
                    font_name: "DMSansMedium"
                    font_size: "16sp"
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    shorten: True
                Label:
                    text: root.artista
                    font_size: "13sp"
                    color: .75, .75, .78, 1
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    shorten: True
            Widget:
                size_hint_x: None
                width: dp(44)
        FloatLayout:
            ScrollView:
                id: rolagem
                size_hint: 1, 1
                do_scroll_x: False
                bar_width: 0
                BoxLayout:
                    id: caixa
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(8), 0
            BoxLayout:
                orientation: "vertical"
                size_hint: .86, None
                height: dp(190)
                pos_hint: {"center_x": .5, "center_y": .5}
                spacing: dp(16)
                opacity: 0 if root.tem_letra else 1
                disabled: root.tem_letra
                Label:
                    text: root.mensagem
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    font_size: "16sp"
                    color: .8, .8, .84, 1
                Button:
                    text: "Buscando…" if root.buscando else "Buscar letra online"
                    font_name: "DMSansMedium"
                    font_size: "16sp"
                    size_hint_y: None
                    height: dp(50)
                    disabled: root.buscando
                    background_normal: ""
                    background_color: 1, 1, 1, .20
                    on_release: root.buscar_online()

<BotaoVoltar@ButtonBehavior+Widget>:
    size_hint: None, None
    size: dp(44), dp(44)
    opacity: .7 if self.state == "down" else 1
    canvas:
        Color:
            rgba: 1, 1, 1, .12
        Ellipse:
            pos: self.center_x - dp(19), self.center_y - dp(19)
            size: dp(38), dp(38)
        Color:
            rgba: 1, 1, 1, .26
        Line:
            ellipse: self.center_x - dp(19), self.center_y - dp(19), dp(38), dp(38)
            width: dp(1)
        Color:
            rgba: 1, 1, 1, 1
        Line:
            points: self.center_x + dp(3), self.center_y + dp(7), self.center_x - dp(4), self.center_y, self.center_x + dp(3), self.center_y - dp(7)
            width: dp(2.2)
            cap: "round"
            joint: "round"

# Imagem com cantos arredondados. A textura (já recortada em "cover") é calculada
# no main.py (classe ImagemArredondada) e desenhada aqui por um RoundedRectangle.
# Sem imagem (tex vazio), aparece só o fundo cinza-escuro.
<RaizSegura>:
    canvas.before:
        Color:
            rgba: .035, .035, .05, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.cor_capa[0], app.cor_capa[1], app.cor_capa[2], .70
        Rectangle:
            texture: app.tex_orb
            size: self.width * 1.5, self.width * 1.5
            pos: self.right - self.width * .8, self.top - self.width * .85
        Color:
            rgba: app.cor_capa[1], app.cor_capa[2], app.cor_capa[0], .34
        Rectangle:
            texture: app.tex_orb
            size: self.width * 1.6, self.width * 1.6
            pos: self.x - self.width * .9, self.center_y - self.width * .5
        Color:
            rgba: app.cor_capa[0], app.cor_capa[1], app.cor_capa[2], .55
        Rectangle:
            texture: app.tex_orb
            size: self.width * 1.6, self.width * 1.6
            pos: self.x - self.width * .7, self.y - self.width * .8
        Color:
            rgba: app.cor_capa[0], app.cor_capa[1], app.cor_capa[2], root.alfa_fundo
        Rectangle:
            pos: self.pos
            size: self.size
            texture: app.gradiente

<ImagemArredondada>:
    canvas:
        # Sombra suave (só quando sombra: True) - 3 camadas translúcidas
        Color:
            rgba: 0, 0, 0, (.16 if self.sombra else 0)
        RoundedRectangle:
            pos: self.center_x - self.width * self.escala / 2 - dp(6), self.center_y - self.height * self.escala / 2 - dp(14)
            size: self.width * self.escala + dp(12), self.height * self.escala + dp(8)
            radius: [self.raio + dp(8)]
        Color:
            rgba: 0, 0, 0, (.2 if self.sombra else 0)
        RoundedRectangle:
            pos: self.center_x - self.width * self.escala / 2 - dp(2), self.center_y - self.height * self.escala / 2 - dp(7)
            size: self.width * self.escala + dp(4), self.height * self.escala + dp(2)
            radius: [self.raio + dp(3)]
        # Imagem: Rectangle (respeita o recorte da textura) + cantos arredondados via stencil.
        # RoundedRectangle com textura recortada espelhava/esticava a imagem.
        StencilPush
        RoundedRectangle:
            pos: self.center_x - self.width * self.escala / 2, self.center_y - self.height * self.escala / 2
            size: self.width * self.escala, self.height * self.escala
            radius: self.raios if self.raios else [self.raio]
        StencilUse
        Color:
            rgba: (1, 1, 1, self.alfa) if self.tex else COR_CARTAO
        Rectangle:
            pos: self.center_x - self.width * self.escala / 2, self.center_y - self.height * self.escala / 2
            size: self.width * self.escala, self.height * self.escala
            texture: self.tex
        StencilUnUse
        RoundedRectangle:
            pos: self.center_x - self.width * self.escala / 2, self.center_y - self.height * self.escala / 2
            size: self.width * self.escala, self.height * self.escala
            radius: self.raios if self.raios else [self.raio]
        StencilPop
        Color:
            rgba: 1, 1, 1, (.18 * self.alfa if (self.tex and not self.raios) else 0)
        Line:
            rounded_rectangle: self.center_x - self.width * self.escala / 2, self.center_y - self.height * self.escala / 2, self.width * self.escala, self.height * self.escala, min(self.raio, self.width * self.escala / 2, self.height * self.escala / 2)
            width: dp(1)

# Seta para baixo/esquerda desenhada com linhas (não precisa de arquivo de imagem)
<IconeChevron@ButtonBehavior+Widget>:
    size_hint: None, None
    size: dp(44), dp(44)
    opacity: .7 if self.state == "down" else 1
    canvas:
        Color:
            rgba: 1, 1, 1, .12
        Ellipse:
            pos: self.center_x - dp(19), self.center_y - dp(19)
            size: dp(38), dp(38)
        Color:
            rgba: 1, 1, 1, .26
        Line:
            ellipse: self.center_x - dp(19), self.center_y - dp(19), dp(38), dp(38)
            width: dp(1)
        Color:
            rgba: 1, 1, 1, 1
        Line:
            points: self.center_x - dp(8), self.center_y + dp(3.5), self.center_x, self.center_y - dp(4.5), self.center_x + dp(8), self.center_y + dp(3.5)
            width: dp(2.2)
            cap: "round"
            joint: "round"

# As 3 barrinhas (alça da fila)
<IconeBarras@ButtonBehavior+Widget>:
    size_hint: None, None
    size: dp(44), dp(44)
    canvas:
        Color:
            rgba: COR_CINZA
        RoundedRectangle:
            pos: self.center_x - dp(10), self.center_y + dp(7)
            size: dp(20), dp(3)
            radius: [dp(1.5)]
        RoundedRectangle:
            pos: self.center_x - dp(10), self.center_y - dp(1.5)
            size: dp(20), dp(3)
            radius: [dp(1.5)]
        RoundedRectangle:
            pos: self.center_x - dp(10), self.center_y - dp(10)
            size: dp(20), dp(3)
            radius: [dp(1.5)]

<BarraProgresso>:
    canvas:
        Color:
            rgba: 1, 1, 1, .2
        RoundedRectangle:
            pos: self.x, self.center_y - dp(2.5)
            size: self.width, dp(5)
            radius: [dp(2.5)]
        Color:
            rgba: .95, .2, .22, 1
        RoundedRectangle:
            pos: self.x, self.center_y - dp(2.5)
            size: max(self.width * self.fracao, dp(5)), dp(5)
            radius: [dp(2.5)]
        Color:
            rgba: .95, .2, .22, .3
        Ellipse:
            pos: self.x + self.width * self.fracao - dp(12), self.center_y - dp(12)
            size: dp(24), dp(24)
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            pos: self.x + self.width * self.fracao - dp(8), self.center_y - dp(8)
            size: dp(16), dp(16)

# Barrinha do que está tocando; aparece no menu e na playlist. Toque = abre o player.
<MiniPlayer@ButtonBehavior+CartaoVidro>:
    size_hint_y: None
    height: dp(78) if app.tem_musica else 0
    opacity: 1 if app.tem_musica else 0
    disabled: not app.tem_musica
    raio: dp(30)
    padding: dp(14), dp(10), dp(14), dp(12)
    spacing: dp(12)
    on_release: app.ir("player", "up")
    # canvas.after TEM que vir antes dos widgets filhos no .kv (o parser recusa depois).
    canvas.after:
        Color:
            rgba: .95, .2, .22, 1
        RoundedRectangle:
            pos: self.x + dp(30), self.y + dp(7)
            size: (max(0, (self.width - dp(60)) * min(1, max(0, app.posicao / app.duracao))) if app.duracao else 0, dp(2))
            radius: [dp(1)]
    ImagemArredondada:
        size_hint: None, None
        size: dp(52), dp(52)
        pos_hint: {"center_y": .5}
        raio: dp(14)
        source: app.capa_atual
    BoxLayout:
        orientation: "vertical"
        Texto:
            text: app.titulo_atual
            font_name: "DMSansMedium"
            font_size: "16sp"
            valign: "bottom"
            color: 1, 1, 1, 1
        Texto:
            text: app.artista_atual
            font_size: "13sp"
            valign: "top"
            color: COR_CINZA
    BotaoRedondo:
        icone: "arquivos/icones/pause.png" if app.tocando else "arquivos/icones/play.png"
        size: dp(48), dp(48)
        tam_icone: dp(20)
        pos_hint: {"center_y": .5}
        on_release: app.pausar_ou_retomar()


# ======================================================================
# LINHAS DE LISTA
# ======================================================================
# -------- playlist:  1  [capa]  Título / Artista --------
<LinhaMusica>:
    canvas.before:
        Color:
            rgba: (1, 1, 1, .09) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        # separador fino (não aparece nas bordas)
        Color:
            rgba: 1, 1, 1, .07
        Rectangle:
            pos: self.x + dp(46), self.y
            size: self.width - dp(56), dp(1)
    size_hint_y: None
    height: dp(70)
    padding: dp(8), dp(6), dp(4), dp(6)
    spacing: dp(12)
    Texto:
        text: str(root.numero)
        size_hint_x: None
        width: dp(24)
        halign: "center"
        font_size: "15sp"
        color: COR_CINZA
    ImagemArredondada:
        size_hint: None, None
        size: dp(54), dp(54)
        pos_hint: {"center_y": .5}
        raio: dp(14)
        source: root.capa
    BoxLayout:
        orientation: "vertical"
        Texto:
            text: root.titulo
            font_name: "DMSansMedium"
            font_size: "17sp"
            valign: "bottom"
            # a música que está tocando fica vermelha
            color: (1, .27, .3, 1) if root.id_musica == app.id_atual else (1, 1, 1, 1)
        Texto:
            text: root.artista
            font_size: "13sp"
            valign: "top"
            color: COR_CINZA
    Image:
        source: "arquivos/icones/coracao_cheio.png"
        size_hint: None, None
        size: dp(16), dp(16)
        pos_hint: {"center_y": .5}
        color: 1, .27, .3, 1
        opacity: 1 if root.id_musica in app.favoritos else 0
    BotaoMais:
        pos_hint: {"center_y": .5}
        on_release: root.abrir_menu()

# -------- fila ("A Seguir"):  [capa]  Título / Artista   ≡ --------
<LinhaFila>:
    canvas.before:
        Color:
            rgba: (1, 1, 1, .09) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    size_hint_y: None
    height: dp(64)
    padding: 0, dp(4)
    spacing: dp(12)
    ImagemArredondada:
        size_hint: None, None
        size: dp(54), dp(54)
        pos_hint: {"center_y": .5}
        raio: dp(14)
        source: root.capa
    BoxLayout:
        orientation: "vertical"
        Texto:
            text: root.titulo
            font_size: "18sp"
            valign: "bottom"
        Texto:
            text: root.artista
            font_size: "14sp"
            valign: "top"
            color: COR_CINZA
    IconeBarras:
        pos_hint: {"center_y": .5}
        on_release: app.abrir_opcoes_fila(int(root.indice))

# -------- playlist no menu --------
<CartaoPlaylist>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, (.15 if self.state == "down" else .06)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(30)]
        Color:
            rgba: 1, 1, 1, .12
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(30)]
            texture: app.gradiente
        Color:
            rgba: 1, 1, 1, .2
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(30)
            width: dp(1)
        Color:
            rgba: 1, 1, 1, .45
        Line:
            points: self.x + dp(30), self.top - dp(.5), self.right - dp(30), self.top - dp(.5)
            width: dp(1)
        Color:
            rgba: app.cor_capa[0], app.cor_capa[1], app.cor_capa[2], .6
        Line:
            points: self.x + dp(30), self.y + dp(.5), self.right - dp(30), self.y + dp(.5)
            width: dp(1.2)
    size_hint_y: None
    height: min(dp(124), max(dp(88), root.width * .36)) + dp(24)
    padding: dp(12)
    spacing: min(dp(14), root.width * .045)
    ImagemArredondada:
        size_hint: None, None
        size: min(dp(124), max(dp(88), root.width * .36)), min(dp(124), max(dp(88), root.width * .36))
        raio: dp(22)
        source: root.capa
    BoxLayout:
        orientation: "vertical"
        Texto:
            text: root.nome
            bold: True
            font_size: min(sp(30), max(sp(17), self.width * .16))
            valign: "bottom"
            shorten: False
            max_lines: 2
        Texto:
            text: root.subtitulo
            font_size: "12sp"
            valign: "top"
            color: COR_CINZA

# ======================================================================
# TELA DE CADASTRO E LOGIN
# ======================================================================
<PerfilModal>:
    size_hint: .82, None
    height: dp(300)
    auto_dismiss: True
    background: ""
    background_color: 0, 0, 0, 0
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: (.12, .12, .12, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(22)]
        ImagemArredondada:
            size_hint: None, None
            size: dp(76), dp(76)
            pos_hint: {"center_x": .5}
            raio: dp(38)
            source: app.foto_perfil
        Label:
            text: app.usuario_atual
            font_name: "DMSansMedium"
            font_size: "20sp"
        Button:
            text: "Alterar foto de perfil"
            size_hint_y: None
            height: dp(44)
            background_normal: ""
            background_color: (.28, .28, .28, 1)
            on_release: app.abrir_seletor_foto_perfil()
        Button:
            text: "Sair da conta"
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: (.28, .28, .28, 1)
            on_release:
                app.sair_da_conta()
                root.dismiss()
        Button:
            text: "Fechar"
            size_hint_y: None
            height: dp(42)
            background_normal: ""
            background_color: (0, 0, 0, 0)
            on_release: root.dismiss()

<SeletorFotoPerfil>:
    size_hint: .96, .9
    auto_dismiss: True
    title: "Escolher foto"
    BoxLayout:
        orientation: "vertical"
        spacing: dp(8)
        padding: dp(10)
        canvas.before:
            Color:
                rgba: (.12, .12, .12, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(18)]
        FileChooserIconView:
            id: arquivos
            path: root.pasta_inicial
            filters: ["*.png", "*.jpg", "*.jpeg"]
            show_hidden: False
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(8)
            Button:
                text: "Cancelar"
                on_release: root.dismiss()
            Button:
                text: "Usar foto"
                on_release: root.escolher()

<TelaAcesso>:
    BoxLayout:
        orientation: "vertical"
        ScrollView:
            do_scroll_x: False
            bar_width: 0
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(26), dp(22), dp(26), dp(18)
                spacing: dp(12)

                Widget:
                    size_hint_y: None
                    height: dp(8)
                FormaDeOnda:
                Label:
                    text: "My Music"
                    bold: True
                    font_size: "48sp"
                    size_hint_y: None
                    height: dp(58)
                Label:
                    text: "Gospel"
                    bold: True
                    font_size: "26sp"
                    size_hint_y: None
                    height: dp(34)

                BoxLayout:
                    size_hint_y: None
                    height: dp(54)
                    padding: dp(5)
                    canvas.before:
                        Color:
                            rgba: COR_VIDRO
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(24)]
                        Color:
                            rgba: COR_BORDA_VIDRO
                        Line:
                            width: dp(0.8)
                            rounded_rectangle: self.x, self.y, self.width, self.height, dp(24)
                    Button:
                        text: "Cadastro"
                        bold: True
                        font_size: "17sp"
                        background_normal: ""
                        background_color: (.28, .28, .28, 1) if root.modo_cadastro else (0, 0, 0, 0)
                        on_release: root.selecionar_modo(True)
                    Button:
                        text: "Login"
                        bold: True
                        font_size: "17sp"
                        background_normal: ""
                        background_color: (.28, .28, .28, 1) if not root.modo_cadastro else (0, 0, 0, 0)
                        on_release: root.selecionar_modo(False)

                Widget:
                    size_hint_y: None
                    height: dp(4)
                Label:
                    text: "Nome"
                    halign: "left"
                    text_size: self.size
                    font_name: "DMSansMedium"
                    font_size: "20sp"
                    size_hint_y: None
                    height: dp(30)
                TextInput:
                    id: nome
                    hint_text: "Digite seu nome"
                    multiline: False
                    write_tab: False
                    font_size: "18sp"
                    padding: dp(16), dp(16)
                    size_hint_y: None
                    height: dp(60)
                    background_normal: ""
                    background_active: ""
                    background_color: COR_CARTAO
                    foreground_color: COR_BRANCO
                    cursor_color: COR_BRANCO
                    hint_text_color: (.4, .4, .4, 1)
                    on_text_validate: senha.focus = True
                Label:
                    text: "Senha"
                    halign: "left"
                    text_size: self.size
                    font_name: "DMSansMedium"
                    font_size: "20sp"
                    size_hint_y: None
                    height: dp(30)
                TextInput:
                    id: senha
                    hint_text: "Digite sua senha"
                    password: True
                    multiline: False
                    write_tab: False
                    font_size: "18sp"
                    padding: dp(16), dp(16)
                    size_hint_y: None
                    height: dp(60)
                    background_normal: ""
                    background_active: ""
                    background_color: COR_CARTAO
                    foreground_color: COR_BRANCO
                    cursor_color: COR_BRANCO
                    hint_text_color: (.4, .4, .4, 1)
                    on_text_validate: app.cadastrar_usuario() if root.modo_cadastro else app.entrar_usuario()

                BoxLayout:
                    size_hint_y: None
                    height: dp(34)
                    spacing: dp(8)
                    CheckBox:
                        id: manter_conectado
                        size_hint: None, None
                        size: dp(30), dp(30)
                        active: True
                        color: COR_DESTAQUE
                    Label:
                        text: "Manter conectado neste aparelho"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        font_size: "14sp"
                        color: COR_CINZA

                Label:
                    text: root.mensagem
                    color: (.95, .45, .45, 1) if "incorretos" in root.mensagem or "cadastrado" in root.mensagem or "precisa" in root.mensagem or "Informe" in root.mensagem else COR_CINZA
                    halign: "center"
                    text_size: self.size
                    font_size: "13sp"
                    size_hint_y: None
                    height: dp(34)
                Button:
                    text: "Criar conta" if root.modo_cadastro else "Entrar"
                    bold: True
                    font_size: "18sp"
                    size_hint_y: None
                    height: dp(54)
                    background_normal: ""
                    background_color: (.28, .28, .28, 1)
                    on_release: app.cadastrar_usuario() if root.modo_cadastro else app.entrar_usuario()

                Widget:
                    size_hint_y: None
                    height: dp(30)
                Label:
                    text: "Feito por: Miguel Ribeiro"
                    color: COR_CINZA
                    font_size: "14sp"
                    size_hint_y: None
                    height: dp(26)
                Label:
                    text: "Este aplicativo possui apenas as músicas que o criador disponibiliza"
                    color: COR_CINZA
                    font_size: "13sp"
                    halign: "center"
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1] + dp(8)

<TelaEstatisticas>:
    on_pre_enter: root.atualizar()
    BoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(8), dp(16), dp(8)
        spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: max(dp(58), sp(40))
            spacing: dp(8)
            IconeChevron:
                pos_hint: {"center_y": .5}
                on_release: app.voltar_tela()
            Label:
                text: "Estatísticas"
                bold: True
                font_size: "30sp"
                halign: "center"
            Widget:
                size_hint_x: None
                width: dp(44)

        ControleSegmentado:
            id: ctl_aba
            size_hint_y: None
            height: dp(50)
            BotaoSegmentado:
                text: "Músicas"
                font_size: "14sp"
                selecionado: root.aba == "musicas"
                on_release: root.selecionar_aba("musicas")
            BotaoSegmentado:
                text: "Artistas"
                font_size: "14sp"
                selecionado: root.aba == "artistas"
                on_release: root.selecionar_aba("artistas")
            BotaoSegmentado:
                text: "Geral"
                font_size: "14sp"
                selecionado: root.aba == "geral"
                on_release: root.selecionar_aba("geral")

        ControleSegmentado:
            id: ctl_periodo
            size_hint_y: None
            height: dp(50)
            BotaoSegmentado:
                text: "Semana"
                font_size: "13sp"
                selecionado: root.periodo == "semana"
                on_release: root.selecionar_periodo("semana")
            BotaoSegmentado:
                text: "Mês"
                font_size: "13sp"
                selecionado: root.periodo == "mes"
                on_release: root.selecionar_periodo("mes")
            BotaoSegmentado:
                text: "Este ano"
                font_size: "13sp"
                selecionado: root.periodo == "ano"
                on_release: root.selecionar_periodo("ano")

        Label:
            text: "Top músicas" if root.aba == "musicas" else "Artistas mais ouvidos" if root.aba == "artistas" else "Seu resumo"
            font_name: "DMSansMedium"
            font_size: "23sp"
            size_hint_y: None
            height: dp(34)
        Label:
            text: root.nome_periodo
            color: COR_CINZA
            font_size: "13sp"
            size_hint_y: None
            height: dp(22)

        BoxLayout:
            id: lista_estatisticas
            orientation: "vertical"
            spacing: dp(8)

        Label:
            text: root.mensagem
            color: COR_CINZA
            font_size: "12sp"
            halign: "center"
            size_hint_y: None
            height: dp(28)
        Button:
            text: "Gerando captura…" if root.capturando else "Salvar captura em Downloads"
            size_hint_y: None
            height: dp(48)
            disabled: root.capturando
            background_normal: ""
            background_color: (.28, .28, .28, 1)
            on_release: root.gerar_captura()

# ======================================================================
# TELA 1: MENU
# ======================================================================
<TelaMenu>:
    BoxLayout:
        orientation: "vertical"
        ScrollView:
            do_scroll_x: False
            bar_width: 0
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(16), dp(20), dp(16), dp(16)
                spacing: dp(6)

                BoxLayout:
                    size_hint_y: None
                    height: max(dp(84), sp(58))
                    Label:
                        text: "My Music"
                        bold: True
                        font_size: min(sp(50), self.width * .17)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        shorten: True
                    IconePerfil:
                        on_release: app.abrir_perfil()

                Texto:
                    text: "Minhas Playlists"
                    font_name: "DMSansMedium"
                    font_size: "17sp"
                    size_hint_y: None
                    height: dp(30)
                # as playlists são criadas pelo main.py (TelaMenu.montar)
                BoxLayout:
                    id: lista_playlists
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)
                Widget:
                    size_hint_y: None
                    height: dp(10)

                # Cartão de vidro clicável: abre a grade de artistas
                BotaoCaixa:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(14)
                    spacing: dp(4)
                    on_release: app.ir("artistas")
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, (.14 if self.state == "down" else .06)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(30)]
                        Color:
                            rgba: 1, 1, 1, .12
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(30)]
                            texture: app.gradiente
                        Color:
                            rgba: 1, 1, 1, .2
                        Line:
                            rounded_rectangle: self.x, self.y, self.width, self.height, dp(30)
                            width: dp(1)
                        Color:
                            rgba: 1, 1, 1, .45
                        Line:
                            points: self.x + dp(30), self.top - dp(.5), self.right - dp(30), self.top - dp(.5)
                            width: dp(1)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(8)
                        padding: dp(4), 0, dp(2), 0
                        BoxLayout:
                            orientation: "vertical"
                            Texto:
                                text: "Artistas"
                                font_name: "DMSansMedium"
                                font_size: "20sp"
                                valign: "bottom"
                            Subtitulo:
                                text: "Artistas e álbuns"
                                valign: "top"
                        SetaCirculo:
                            pos_hint: {"center_y": .5}
                    Widget:
                        size_hint_y: None
                        height: dp(4)
                    ImagemArredondada:
                        size_hint_y: None
                        height: dp(157)
                        raio: dp(22)
                        source: "arquivos/menu/artistas.jpg"
                Widget:
                    size_hint_y: None
                    height: dp(10)

                Texto:
                    text: "Estatísticas"
                    font_name: "DMSansMedium"
                    font_size: "17sp"
                    size_hint_y: None
                    height: dp(26)
                Subtitulo:
                    text: "Musicas mais tocadas - artistas mais ouvidos - Tempo ouvindo música"
                Widget:
                    size_hint_y: None
                    height: dp(4)
                FloatLayout:           # por enquanto só visual (sem função)
                    size_hint_y: None
                    height: dp(99)
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, .1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(24)]
                    Image:
                        source: "arquivos/icones/estatisticas.png"
                        size_hint: None, None
                        size: dp(100), dp(72)
                        pos_hint: {"center_x": .5, "center_y": .5}
                    Button:
                        text: ""
                        background_normal: ""
                        background_color: (0, 0, 0, 0)
                        size_hint: 1, 1
                        pos: self.parent.pos
                        on_release: app.abrir_estatisticas()
        MiniPlayer:

# ======================================================================
# TELA 2: PLAYLIST
# ======================================================================
<LinhaAdicionar>:
    size_hint_y: None
    height: dp(72)
    padding: dp(4), dp(8)
    spacing: dp(12)
    Widget:
        size_hint: None, None
        size: dp(46), dp(46)
        pos_hint: {"center_y": .5}
        canvas:
            Color:
                rgba: COR_VIDRO
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(23)]
            Color:
                rgba: COR_BORDA_VIDRO
            Line:
                width: dp(0.8)
                rounded_rectangle: self.x, self.y, self.width, self.height, dp(23)
            Color:
                rgba: COR_DESTAQUE
            Rectangle:
                pos: self.center_x - dp(10), self.center_y - dp(1.5)
                size: dp(20), dp(3)
            Rectangle:
                pos: self.center_x - dp(1.5), self.center_y - dp(10)
                size: dp(3), dp(20)
    Texto:
        text: "Adicionar música"
        font_size: "17sp"
        color: COR_DESTAQUE

<SeletorArquivo>:
    size_hint: .96, .9
    auto_dismiss: True
    title: root.titulo
    BoxLayout:
        orientation: "vertical"
        spacing: dp(8)
        padding: dp(10)
        canvas.before:
            Color:
                rgba: (.12, .12, .12, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(18)]
        FileChooserIconView:
            id: arquivos
            path: root.pasta_inicial
            filters: root.filtros
            show_hidden: False
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(8)
            Button:
                text: "Cancelar"
                on_release: root.dismiss()
            Button:
                text: "Selecionar"
                on_release: root.escolher()

<CampoForm@TextInput>:
    size_hint_y: None
    height: dp(44)
    multiline: False
    background_normal: ""
    background_active: ""
    background_color: COR_CARTAO
    foreground_color: 1, 1, 1, 1
    hint_text_color: COR_CINZA
    cursor_color: 1, 1, 1, 1
    padding: dp(14), dp(12)

<SeletorForm@Spinner>:
    size_hint_y: None
    height: dp(44)
    background_normal: ""
    background_color: COR_CARTAO
    color: 1, 1, 1, 1

<AdicionarMusicaModal>:
    size_hint: .94, .92
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(8)
        canvas.before:
            Color:
                rgba: (.12, .12, .12, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(22)]
        Label:
            text: "Adicionar música"
            font_name: "DMSansMedium"
            font_size: "20sp"
            size_hint_y: None
            height: dp(36)
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
                Button:
                    text: root.nome_arquivo
                    size_hint_y: None
                    height: dp(48)
                    shorten: True
                    shorten_from: "left"
                    text_size: self.width - dp(16), None
                    halign: "center"
                    background_normal: ""
                    background_color: (.28, .28, .28, 1)
                    on_release: root.escolher_audio()
                CampoForm:
                    id: titulo
                    hint_text: "Nome da música"
                Subtitulo:
                    text: "Artista"
                SeletorForm:
                    id: sp_artista
                    values: root.artistas
                    on_text: root.ao_mudar_artista(self.text)
                CampoForm:
                    id: nome_artista
                    hint_text: "Nome do novo artista"
                    height: dp(44) if root.novo_artista else 0
                    opacity: 1 if root.novo_artista else 0
                    disabled: not root.novo_artista
                Subtitulo:
                    text: "Álbum"
                SeletorForm:
                    id: sp_album
                    values: root.albuns
                    on_text: root.ao_mudar_album(self.text)
                CampoForm:
                    id: nome_album
                    hint_text: "Nome do novo álbum"
                    height: dp(44) if root.novo_album else 0
                    opacity: 1 if root.novo_album else 0
                    disabled: not root.novo_album
                CampoForm:
                    id: ano
                    hint_text: "Ano (opcional)"
                    input_filter: "int"
                CampoForm:
                    id: generos
                    hint_text: "Gêneros separados por vírgula (opcional)"
                BoxLayout:
                    size_hint_y: None
                    height: dp(64)
                    spacing: dp(12)
                    ImagemArredondada:
                        size_hint: None, None
                        size: dp(64), dp(64)
                        raio: dp(10)
                        source: root.capa
                    Button:
                        text: "Trocar capa do álbum" if root.capa else "Escolher capa do álbum (opcional)"
                        background_normal: ""
                        background_color: (.28, .28, .28, 1)
                        on_release: root.escolher_capa()
        Label:
            text: root.erro
            color: COR_DESTAQUE
            font_size: "13sp"
            size_hint_y: None
            height: dp(26) if root.erro else 0
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            Button:
                text: "Cancelar"
                on_release: root.dismiss()
            Button:
                text: "Salvar"
                background_normal: ""
                background_color: COR_DESTAQUE
                on_release: root.salvar()

<TelaPlaylist>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14), dp(10), dp(14), dp(10)
        spacing: dp(10)

        # Cabeçalho com botão de retorno explícito
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            BotaoVoltar:
                on_release: app.voltar_tela()
            Label:
                text: "Minhas playlists"
                font_name: "DMSansMedium"
                font_size: "17sp"
                color: .86, .88, 1, 1
                halign: "center"
                valign: "middle"
                text_size: self.size
            Widget:
                size_hint_x: None
                width: dp(44)

        # Cabeçalho (cartão de vidro): capa à esquerda, textos e botões à direita
        CartaoVidro:
            id: cab_playlist
            size_hint_y: None
            height: min(dp(152), max(dp(124), root.width * .42))
            raio: dp(30)
            padding: dp(14)
            spacing: min(dp(16), root.width * .04)
            ImagemArredondada:
                size_hint: None, None
                size: cab_playlist.height - dp(28), cab_playlist.height - dp(28)
                raio: dp(20)
                source: root.capa_playlist
            BoxLayout:
                orientation: "vertical"
                Texto:
                    text: root.nome_playlist
                    bold: True
                    font_size: min(sp(28), max(sp(17), self.width * .14))
                    valign: "bottom"
                    shorten: False
                    max_lines: 2
                Texto:
                    text: root.subtitulo
                    font_size: "14sp"
                    color: COR_CINZA
                    size_hint_y: None
                    height: dp(24)
                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)
                    BotaoRedondo:
                        icone: "arquivos/icones/play.png"
                        estilo: "destaque"
                        size: dp(48), dp(48)
                        tam_icone: dp(20)
                        on_release: root.tocar_a_partir_de(0)
                    BotaoRedondo:
                        icone: "arquivos/icones/shuffle.png"
                        size: dp(48), dp(48)
                        tam_icone: dp(24)
                        on_release: root.tocar_aleatorio()
                    BotaoRedondo:
                        icone: "arquivos/icones/busca.png"
                        size: dp(48), dp(48)
                        tam_icone: dp(22)
                        on_release: root.alternar_busca()
                    Widget:   # espaçador: empurra os botões para a esquerda

        # Campo de busca: some quando fechado (altura 0)
        TextInput:
            id: campo_busca
            size_hint_y: None
            height: dp(44) if root.busca_aberta else 0
            opacity: 1 if root.busca_aberta else 0
            disabled: not root.busca_aberta
            multiline: False
            hint_text: "Buscar na playlist"
            background_normal: ""
            background_active: ""
            background_color: 1, 1, 1, .09
            foreground_color: 1, 1, 1, 1
            hint_text_color: COR_CINZA
            cursor_color: 1, 1, 1, 1
            padding: dp(16), dp(12)
            on_text: root.filtrar(self.text)

        # Filtros: ordenar (padrão / música / artista / álbum), direção e favoritos em cima
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(8)
            ChipVidro:
                size_hint_x: None
                width: dp(118)
                texto: "Ordenar"
                icone: "arquivos/icones/filtro.png"
                ativo: root.filtros_abertos or root.ordem_por != "padrao"
                on_release: root.filtros_abertos = not root.filtros_abertos
            ChipVidro:
                size_hint_x: None
                width: dp(86)
                texto: "A → Z" if root.crescente else "Z → A"
                esmaecido: root.ordem_por == "padrao"
                on_release: root.alternar_direcao()
            ChipVidro:
                texto: "Favoritos em cima"
                icone: "arquivos/icones/coracao_cheio.png"
                ativo: root.favoritos_em_cima
                on_release: root.alternar_favoritos_em_cima()
        BoxLayout:
            size_hint_y: None
            height: dp(40) if root.filtros_abertos else 0
            opacity: 1 if root.filtros_abertos else 0
            disabled: not root.filtros_abertos
            spacing: dp(8)
            ChipVidro:
                texto: "Padrão"
                ativo: root.ordem_por == "padrao"
                on_release: root.definir_ordem("padrao")
            ChipVidro:
                texto: "Música"
                ativo: root.ordem_por == "titulo"
                on_release: root.definir_ordem("titulo")
            ChipVidro:
                texto: "Artista"
                ativo: root.ordem_por == "artista"
                on_release: root.definir_ordem("artista")
            ChipVidro:
                texto: "Álbum"
                ativo: root.ordem_por == "album"
                on_release: root.definir_ordem("album")

        # A LISTA (dentro de um painel de vidro). RecycleView só cria os widgets que
        # cabem na tela e os "recicla" ao rolar - essencial para listas grandes.
        CartaoVidro:
            raio: dp(30)
            padding: dp(8), dp(10), dp(8), dp(10)
            RecycleView:
                id: lista
                key_viewclass: "viewclass"
                viewclass: "LinhaMusica"
                bar_width: 0
                RecycleBoxLayout:
                    orientation: "vertical"
                    default_size: None, dp(70)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height

        MiniPlayer:

# ======================================================================
# TELA 3: PLAYER (tocando agora)
# ======================================================================
# Texto de várias linhas: a altura cresce conforme o texto (descrições, listas).
<TextoMulti@Label>:
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1]
    halign: "left"
    valign: "top"

# Cartão de vidro (usado em "Sobre o artista/música").
<CartaoInfo@CartaoVidro>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    raio: dp(33)

# Igual ao CartaoInfo, mas clicável: fica um pouco mais claro enquanto é pressionado.
<CartaoArtista@ButtonBehavior+CartaoVidro>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    raio: dp(33)
    opacity: .85 if self.state == "down" else 1

# Linha da letra sob o artista: até 2 linhas, alinhada à esquerda, clicável.
<LinhaDaLetra@ButtonBehavior+Label>:
    size_hint_y: 1
    text_size: self.width, self.height - dp(6)
    halign: "left"
    valign: "middle"
    max_lines: 2
    line_height: 1.08
    font_name: "DMSansMedium"
    # tamanho por comprimento: linhas curtas maiores; as mais longas cabem em 1-2 linhas
    font_size: sp(18) if len(self.text) <= 30 else (sp(15) if len(self.text) <= 40 else sp(13))

# Uma linha do cartão "Prévia da letra". 'destaque' = a linha cantada agora (maior, negrito).
<LinhaPrevia@Label>:
    destaque: False
    size_hint_y: None
    height: dp(94) if self.destaque else dp(54)
    text_size: self.width, self.height
    halign: "left"
    valign: "middle"
    max_lines: 2
    line_height: 1.08
    font_name: "DMSansMedium"
    bold: self.destaque
    font_size: sp(26) if self.destaque else sp(18)
    color: 1, 1, 1, .5

# Pílula branca com texto escuro (como o "Mostrar letra" do Spotify).
<BotaoPilula@ButtonBehavior+Label>:
    size_hint: None, None
    size: dp(150), dp(44)
    font_name: "DMSansMedium"
    font_size: "15sp"
    color: .08, .08, .1, 1
    canvas.before:
        Color:
            rgba: 1, 1, 1, (.8 if self.state == "down" else 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

<TelaPlayer>:
    # Sempre que a tela abre, volta para o topo (o player em si)
    on_pre_enter: rolagem.scroll_y = 1

    # O player é uma tela "comprida": a 1ª parte (do tamanho da tela) é o player e,
    # arrastando para cima, aparecem os cartões sobre o artista e a música.
    ScrollView:
        id: rolagem
        do_scroll_x: False
        bar_width: 0
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height

            # ================= PARTE 1: O PLAYER =================
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: root.height
                padding: dp(21), dp(14), dp(21), dp(10)

                # Barra do topo: seta (voltar) | "Tocando agora" + playlist | espaço
                BoxLayout:
                    size_hint_y: None
                    height: dp(52)
                    IconeChevron:
                        pos_hint: {"center_y": .5}
                        on_release: app.voltar_tela()
                    BoxLayout:
                        orientation: "vertical"
                        Label:
                            text: "Tocando agora"
                            font_size: "12sp"
                            color: COR_CINZA
                            valign: "bottom"
                            text_size: self.size
                            halign: "center"
                        Label:
                            text: app.origem
                            font_name: "DMSansMedium"
                            font_size: "17sp"
                            color: 1, 1, 1, 1
                            valign: "top"
                            text_size: self.size
                            halign: "center"
                            shorten: True
                    Widget:
                        size_hint_x: None
                        width: dp(44)

                # O espaço livre fica acima da capa para aproximar título,
                # artista e barra de reprodução.
                Widget:
                    size_hint_y: 2

                # Capa dentro de uma moldura de vidro, com halo de luz na cor da capa.
                AnchorLayout:
                    id: area_capa
                    size_hint_y: None
                    height: min(self.width, max(dp(120), root.height - dp(352)))
                    canvas.before:
                        Color:
                            rgba: app.cor_capa[0], app.cor_capa[1], app.cor_capa[2], .65
                        Rectangle:
                            texture: app.tex_orb
                            size: min(self.width, self.height) * 1.7, min(self.width, self.height) * 1.7
                            pos: self.center_x - min(self.width, self.height) * .85, self.center_y - min(self.width, self.height) * .95
                        Color:
                            rgba: 1, 1, 1, .07
                        RoundedRectangle:
                            pos: self.center_x - min(self.width, self.height) / 2, self.center_y - min(self.width, self.height) / 2
                            size: min(self.width, self.height), min(self.width, self.height)
                            radius: [dp(40)]
                        Color:
                            rgba: 1, 1, 1, .12
                        RoundedRectangle:
                            pos: self.center_x - min(self.width, self.height) / 2, self.center_y - min(self.width, self.height) / 2
                            size: min(self.width, self.height), min(self.width, self.height)
                            radius: [dp(40)]
                            texture: app.gradiente
                        Color:
                            rgba: 1, 1, 1, .22
                        Line:
                            rounded_rectangle: self.center_x - min(self.width, self.height) / 2, self.center_y - min(self.width, self.height) / 2, min(self.width, self.height), min(self.width, self.height), dp(40)
                            width: dp(1)
                        Color:
                            rgba: .95, .2, .22, .5
                        Line:
                            points: self.center_x - min(self.width, self.height) / 2 + dp(40), self.center_y - min(self.width, self.height) / 2 + dp(.5), self.center_x + min(self.width, self.height) / 2 - dp(40), self.center_y - min(self.width, self.height) / 2 + dp(.5)
                            width: dp(1.4)
                    ImagemArredondada:
                        id: capa_player
                        sombra: True
                        size_hint: None, None
                        size: min(area_capa.width, area_capa.height) - dp(26), min(area_capa.width, area_capa.height) - dp(26)
                        raio: dp(28)
                        source: app.capa_atual

                Widget:
                    size_hint_y: None
                    height: dp(14)

                # Título + artista | botão "mais" (abre os cartões sobre o artista/música)
                BoxLayout:
                    size_hint_y: None
                    height: dp(68)
                    spacing: dp(10)
                    padding: dp(4), 0, dp(2), 0
                    BoxLayout:
                        orientation: "vertical"
                        Texto:
                            text: app.titulo_atual
                            bold: True
                            font_size: sp(28) if len(self.text) <= 14 else (sp(22) if len(self.text) <= 24 else sp(18))
                            size_hint_y: None
                            height: dp(40)
                        Texto:
                            text: app.artista_atual
                            font_size: "18sp"
                            color: COR_CINZA
                            size_hint_y: None
                            height: dp(28)
                    BotaoRedondo:
                        icone: "arquivos/icones/coracao_cheio.png" if app.id_atual in app.favoritos else "arquivos/icones/coracao.png"
                        tinta: (1, .27, .3, 1) if app.id_atual in app.favoritos else (1, 1, 1, .9)
                        size: dp(42), dp(42)
                        tam_icone: dp(22)
                        pos_hint: {"center_y": .5}
                        on_release: app.alternar_favorita(app.id_atual)
                    BotaoRedondo:
                        icone: "arquivos/icones/mais.png"
                        size: dp(42), dp(42)
                        tam_icone: dp(22)
                        pos_hint: {"center_y": .5}
                        on_release: app.abrir_menu_musica(app.id_atual, app.titulo_atual, app.artista_atual, app.capa_atual, True)

                # Só a linha cantada agora (letras sincronizadas); toque abre a letra inteira.
                LinhaDaLetra:
                    text: root.letra_linha
                    # cinza (um pouco mais claro que o nome do artista) e piscando de leve ao trocar
                    color: .74, .75, .82, root.letra_alfa

                BarraProgresso:
                    id: barra
                    size_hint_y: None
                    height: dp(28)
                    progresso: min(1, app.posicao / app.duracao) if app.duracao else 0

                BoxLayout:
                    size_hint_y: None
                    height: dp(20)
                    Texto:
                        text: app.formatar_tempo(barra.fracao * app.duracao)
                        font_size: "13sp"
                        color: COR_CINZA
                    Texto:
                        text: app.formatar_tempo(app.duracao)
                        halign: "right"
                        font_size: "13sp"
                        color: COR_CINZA

                # Controles: aleatório | anterior - play/pause - próxima | fila
                BoxLayout:
                    size_hint_y: None
                    height: dp(88)
                    spacing: dp(4)
                    BotaoRedondo:
                        icone: "arquivos/icones/shuffle.png"
                        estilo: "limpo"
                        size: dp(46), dp(46)
                        tam_icone: dp(26)
                        tinta: (1, .27, .3, 1) if app.aleatorio else (1, 1, 1, .6)
                        pos_hint: {"center_y": .5}
                        on_release: app.alternar_aleatorio()
                    Widget:
                    BotaoRedondo:
                        icone: "arquivos/icones/back.png"
                        estilo: "limpo"
                        size: dp(52), dp(52)
                        tam_icone: dp(32)
                        pos_hint: {"center_y": .5}
                        on_release: app.faixa_anterior()
                    BotaoRedondo:
                        icone: "arquivos/icones/pause.png" if app.tocando else "arquivos/icones/play.png"
                        estilo: "destaque"
                        size: dp(76), dp(76)
                        tam_icone: dp(30)
                        pos_hint: {"center_y": .5}
                        on_release: app.pausar_ou_retomar()
                    BotaoRedondo:
                        icone: "arquivos/icones/advance.png"
                        estilo: "limpo"
                        size: dp(52), dp(52)
                        tam_icone: dp(32)
                        pos_hint: {"center_y": .5}
                        on_release: app.pular()
                    Widget:
                    BotaoRedondo:
                        icone: "arquivos/icones/queue.png"
                        estilo: "limpo"
                        size: dp(46), dp(46)
                        tam_icone: dp(28)
                        pos_hint: {"center_y": .5}
                        on_release: app.ir("fila", "left")

            # ================= PARTE 2: SOBRE O ARTISTA / A MÚSICA =================
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20), dp(20), dp(20), dp(40)
                spacing: dp(24)

                # ---- Cartão "Prévia da letra": 2 linhas antes, a atual (grande) e 2 depois ----
                CartaoInfo:
                    padding: dp(24), dp(18), dp(24), dp(22)
                    spacing: dp(8)
                    Texto:
                        text: "Prévia da letra"
                        bold: True
                        font_size: "20sp"
                        size_hint_y: None
                        height: dp(32)
                    BoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height if root.letra_tem else 0
                        opacity: 1 if root.letra_tem else 0
                        spacing: dp(6)
                        LinhaPrevia:
                            text: root.letra_a2
                        LinhaPrevia:
                            text: root.letra_a1
                        LinhaPrevia:
                            text: root.letra_atual
                            destaque: root.letra_sincronizada
                            color: 1, 1, 1, (root.letra_alfa if root.letra_sincronizada else .55)
                        LinhaPrevia:
                            text: root.letra_p1
                        LinhaPrevia:
                            text: root.letra_p2
                    Label:
                        text: root.letra_msg
                        size_hint_y: None
                        height: 0 if root.letra_tem else dp(64)
                        opacity: 0 if root.letra_tem else 1
                        text_size: self.width, self.height
                        halign: "left"
                        valign: "middle"
                        font_size: "15sp"
                        color: COR_CINZA
                    BoxLayout:
                        size_hint_y: None
                        height: dp(52)
                        padding: 0, dp(6), 0, 0
                        BotaoPilula:
                            text: "Mostrar letra" if root.letra_tem else "Buscar letra"
                            on_release: app.ir("letra", "up")
                        Widget:

                # ---- Cartão "Sobre o Artista" (toque = abre a página do artista) ----
                CartaoArtista:
                    on_release: app.abrir_artista_atual()
                    # Foto grande com o título por cima (só os cantos de cima arredondados)
                    # IMPORTANTE: o FloatLayout só posiciona o filho se ele tiver pos_hint.
                    # Sem "pos_hint: {"x": 0, "y": 0}" o filho fica preso em (0, 0), o canto
                    # inferior esquerdo da JANELA, e a foto aparece fora do cartão.
                    FloatLayout:
                        size_hint_y: None
                        height: dp(218)
                        ImagemArredondada:
                            size_hint: 1, 1
                            pos_hint: {"x": 0, "y": 0}
                            raios: [dp(33), dp(33), 0, 0]
                            source: app.info_artista_foto
                        BoxLayout:
                            size_hint: 1, 1
                            pos_hint: {"x": 0, "y": 0}
                            padding: dp(25), dp(16), dp(25), 0
                            Texto:
                                text: "Sobre o Artista"
                                bold: True
                                font_size: "21sp"
                                valign: "top"

                    # Fotinho redonda + nome
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        padding: dp(18), dp(6), dp(18), 0
                        spacing: dp(8)
                        ImagemArredondada:
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"center_y": .5}
                            raio: dp(14)
                            source: app.info_artista_logo
                        Texto:
                            text: app.info_artista_nome
                            font_size: "20sp"
                            bold: True
                            shorten: False

                    # Descrição
                    BoxLayout:
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(20), dp(2), dp(20), dp(22)
                        TextoMulti:
                            text: app.info_artista_descricao
                            font_size: sp(11.5)
                            color: .78, .8, .9, 1
                            line_height: 1.12

                # ---- Cartão "Sobre a música" ----
                CartaoInfo:
                    padding: dp(25), dp(16), dp(25), dp(22)
                    spacing: dp(6)
                    Texto:
                        text: "Sobre a música"
                        bold: True
                        font_size: "21sp"
                        size_hint_y: None
                        height: dp(32)
                    TextoMulti:
                        text: app.info_musica
                        font_size: "15sp"
                        color: .78, .8, .9, 1
                        line_height: 1.2

# ======================================================================
# TELA 4: FILA
# ======================================================================
# Linha vermelha da música que está tocando (fixa no topo; toque = volta ao player)
<LinhaAtual@ButtonBehavior+BoxLayout>:
    spacing: dp(12)
    on_release: app.voltar_tela()
    ImagemArredondada:
        size_hint: None, None
        size: dp(56), dp(56)
        pos_hint: {"center_y": .5}
        raio: dp(14)
        source: app.capa_atual
    BoxLayout:
        orientation: "vertical"
        Texto:
            text: app.titulo_atual
            font_size: "18sp"
            valign: "bottom"
            color: COR_DESTAQUE
        Texto:
            text: app.artista_atual
            font_size: "14sp"
            valign: "top"
            color: COR_CINZA
    BotaoRedondo:
        icone: "arquivos/icones/pause.png" if app.tocando else "arquivos/icones/play.png"
        estilo: "destaque"
        size: dp(48), dp(48)
        tam_icone: dp(20)
        pos_hint: {"center_y": .5}
        on_release: app.pausar_ou_retomar()

<BotaoAleatorio@ButtonBehavior+BoxLayout>:
    orientation: "vertical"
    size_hint: None, None
    size: dp(140), dp(60)
    padding: dp(6), dp(8), dp(6), dp(4)
    canvas.before:
        Color:
            rgba: (.95, .2, .22, .30) if app.aleatorio else (1, 1, 1, .09)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]
        Color:
            rgba: (.95, .2, .22, .7) if app.aleatorio else (1, 1, 1, .22)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(22)
            width: dp(1)
    Image:
        source: "arquivos/icones/shuffle.png"
    Label:
        text: "Ordem Aleatória"
        font_size: "13sp"
        size_hint_y: None
        height: dp(18)

<TelaFila>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(22), dp(22), dp(22), dp(10)
        spacing: dp(6)

        Texto:
            text: "Fila"
            bold: True
            font_size: "36sp"
            size_hint_y: None
            height: dp(46)
        BoxLayout:
            size_hint_y: None
            height: dp(26)
            Texto:
                text: "Tocando agora"
                font_size: "12sp"
                color: COR_CINZA
                size_hint_x: None
                width: dp(92)
            Texto:
                text: app.origem
                font_name: "DMSansMedium"
                font_size: "18sp"
        LinhaAtual:
            size_hint_y: None
            height: dp(64) if app.tem_musica else 0
            opacity: 1 if app.tem_musica else 0
            disabled: not app.tem_musica
        Texto:
            text: "A Seguir"
            bold: True
            font_size: "28sp"
            size_hint_y: None
            height: dp(52)

        RecycleView:
            id: lista
            viewclass: "LinhaFila"
            RecycleBoxLayout:
                orientation: "vertical"
                default_size: None, dp(64)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: dp(70)
            padding: 0, dp(5)
            Widget:
            BotaoAleatorio:
                pos_hint: {"center_y": .5}
                on_release: app.alternar_aleatorio()
            Widget:

# ======================================================================
# JANELINHA DAS 3 BARRINHAS (opções de uma música da fila)
# ======================================================================
<OpcoesFila>:
    size_hint: .88, None
    height: dp(300)
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, .65
    canvas.before:
        Color:
            rgba: .13, .13, .13, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]
    BoxLayout:
        orientation: "vertical"
        padding: dp(20), dp(16)
        spacing: dp(2)
        Texto:
            text: root.titulo
            bold: True
            font_size: "17sp"
            size_hint_y: None
            height: dp(26)
        Texto:
            text: root.artista
            font_size: "13sp"
            color: COR_CINZA
            size_hint_y: None
            height: dp(20)
        Widget:
            size_hint_y: None
            height: dp(8)
        BotaoOpcao:
            text: "Tocar a seguir"
            on_release: root.acao("seguir")
        BotaoOpcao:
            text: "Mover para cima"
            on_release: root.acao("subir")
        BotaoOpcao:
            text: "Mover para baixo"
            on_release: root.acao("descer")
        BotaoOpcao:
            text: "Remover da fila"
            color: COR_DESTAQUE
            on_release: root.acao("remover")


# ======================================================================
# TELA: ARTISTAS (lista) - abre pelo "Banco de dados" do menu
# ======================================================================
<LinhaArtista>:
    orientation: "vertical"
    size_hint_y: None
    height: self.width * 1.2
    padding: dp(12), dp(16), dp(12), dp(12)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 1, 1, 1, (.15 if self.state == "down" else .06)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(28)]
        Color:
            rgba: 1, 1, 1, .12
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(28)]
            texture: app.gradiente
        Color:
            rgba: 1, 1, 1, .2
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(28)
            width: dp(1)
        Color:
            rgba: 1, 1, 1, .45
        Line:
            points: self.x + dp(28), self.top - dp(.5), self.right - dp(28), self.top - dp(.5)
            width: dp(1)
        # anel de vidro em volta da foto
        Color:
            rgba: 1, 1, 1, .28
        Line:
            circle: self.center_x, self.top - dp(16) - self.width * .26, self.width * .26 + dp(5)
            width: dp(1.2)
    ImagemArredondada:
        size_hint: None, None
        size: root.width * .52, root.width * .52
        pos_hint: {"center_x": .5}
        raio: self.width / 2          # metade do tamanho = círculo perfeito
        source: root.logo
    Widget:
        size_hint_y: None
        height: dp(2)
    Texto:
        text: root.nome
        font_name: "DMSansMedium"
        font_size: "16sp"
        halign: "center"
        valign: "middle"
        shorten: False
        max_lines: 2
    Texto:
        text: root.detalhe
        font_size: "12sp"
        halign: "center"
        color: COR_CINZA
        size_hint_y: None
        height: dp(16)

<TelaArtistas>:
    BoxLayout:
        orientation: "vertical"
        ScrollView:
            do_scroll_x: False
            bar_width: 0
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(16), dp(14), dp(16), dp(20)
                spacing: dp(6)
                BotaoVoltar:
                    on_release: app.voltar_tela()
                Texto:
                    text: "Artistas"
                    bold: True
                    font_size: "40sp"
                    shorten: False
                    size_hint_y: None
                    height: dp(58)
                Texto:
                    text: root.resumo
                    font_size: "15sp"
                    color: COR_CINZA
                    size_hint_y: None
                    height: dp(24)
                Widget:
                    size_hint_y: None
                    height: dp(8)
                # os cartões são criados pelo main.py (TelaArtistas.montar)
                GridLayout:
                    id: lista_artistas
                    cols: 2
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(12)
        MiniPlayer:

# ======================================================================
# TELA: UM ARTISTA - estrutura fixa: foto, Biografia, Discografia, Integrantes
# ======================================================================
<ParagrafoBio>:
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1]
    halign: "justify"
    valign: "top"
    font_size: "14sp"
    line_height: 1.12
    color: .88, .89, .96, 1

<LinhaInfo>:
    markup: True
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1]
    halign: "left"
    valign: "top"
    font_size: "15sp"
    line_height: 1.1
    color: .88, .89, .96, 1

# Álbum do carrossel da discografia: capa quadrada + nome
<CartaoAlbumMini>:
    orientation: "vertical"
    size_hint: None, None
    size: dp(128), dp(178)
    spacing: dp(6)
    opacity: .75 if self.state == "down" else 1
    ImagemArredondada:
        size_hint: None, None
        size: dp(128), dp(128)
        raio: dp(20)
        source: root.capa
    Texto:
        text: root.nome
        font_size: "13sp"
        valign: "top"
        shorten: False
        max_lines: 2

# Capa da discografia: sempre quadrada (a altura acompanha a largura da coluna)
<CapaAlbum>:
    size_hint_y: None
    height: self.width
    raio: dp(10)
    opacity: .7 if self.state == "down" else 1

# Bolinha branca com seta (para a direita; para cima quando a lista está aberta)
<SetaCirculo>:
    size_hint: None, None
    size: dp(30), dp(30)
    canvas:
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: .08, .08, .08, 1
        Line:
            points: (self.center_x - dp(3), self.center_y + dp(6), self.center_x + dp(4), self.center_y, self.center_x - dp(3), self.center_y - dp(6)) if not self.aberto else (self.center_x - dp(6), self.center_y - dp(3), self.center_x, self.center_y + dp(4), self.center_x + dp(6), self.center_y - dp(3))
            width: dp(2.2)
            cap: "round"
            joint: "round"

<TelaArtista>:
    BoxLayout:
        orientation: "vertical"
        ScrollView:
            id: rolagem
            do_scroll_x: False
            bar_width: 0
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(16), dp(14), dp(16), dp(24)
                spacing: dp(14)

                BotaoVoltar:
                    on_release: app.voltar_tela()

                # Capa da página: foto grande (cortada p/ preencher, sem esticar) e,
                # por cima, uma barra de vidro com a fotinho redonda, o nome e o resumo.
                FloatLayout:
                    id: hero
                    size_hint_y: None
                    height: self.width * .74
                    ImagemArredondada:
                        size_hint: 1, 1
                        pos_hint: {"x": 0, "y": 0}   # sem isto o FloatLayout não move a foto junto com a rolagem
                        raio: dp(34)
                        source: root.foto
                    Widget:     # escurece o fundo da barra para o texto ler bem sobre qualquer foto
                        size_hint: None, None
                        size: hero.width - dp(24), dp(80)
                        pos: hero.x + dp(12), hero.y + dp(12)
                        canvas:
                            Color:
                                rgba: 0, 0, 0, .5
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(28)]
                    CartaoVidro:
                        size_hint: None, None
                        size: hero.width - dp(24), dp(80)
                        pos: hero.x + dp(12), hero.y + dp(12)
                        raio: dp(28)
                        padding: dp(14), dp(10)
                        spacing: dp(12)
                        ImagemArredondada:
                            size_hint: None, None
                            size: dp(54), dp(54)
                            pos_hint: {"center_y": .5}
                            raio: dp(27)
                            source: root.logo
                        BoxLayout:
                            orientation: "vertical"
                            Texto:
                                text: root.nome
                                bold: True
                                font_size: "26sp" if len(root.nome) <= 12 else "21sp"
                                valign: "bottom"
                            Texto:
                                text: root.resumo
                                font_size: "13sp"
                                valign: "top"
                                color: COR_CINZA

                # Cartão: Biografia (os parágrafos são criados pelo main.py)
                CartaoInfo:
                    padding: dp(22), dp(18), dp(22), dp(20)
                    spacing: dp(10)
                    Texto:
                        text: "Biografia"
                        bold: True
                        font_size: "24sp"
                        shorten: False
                        size_hint_y: None
                        height: dp(34)
                    BoxLayout:
                        id: caixa_bio
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(8)

                # Cartão: Discografia (carrossel: arraste para o lado)
                CartaoInfo:
                    height: self.minimum_height if root.tem_albuns else 0
                    opacity: 1 if root.tem_albuns else 0
                    padding: dp(22), dp(18), 0, dp(18)
                    spacing: dp(12)
                    Texto:
                        text: "Discografia"
                        bold: True
                        font_size: "24sp"
                        shorten: False
                        size_hint_y: None
                        height: dp(34)
                    ScrollView:
                        do_scroll_y: False
                        bar_width: 0
                        size_hint_y: None
                        height: dp(178)
                        GridLayout:
                            id: grade_albuns
                            rows: 1
                            size_hint: None, None
                            width: self.minimum_width
                            height: dp(178)
                            spacing: dp(14)
                            padding: 0, 0, dp(22), 0

                # Cartão: Integrantes (uma linha por função: função em vermelho, nomes embaixo)
                CartaoInfo:
                    padding: dp(22), dp(18), dp(22), dp(20)
                    spacing: dp(10)
                    Texto:
                        text: "Integrantes"
                        bold: True
                        font_size: "24sp"
                        shorten: False
                        size_hint_y: None
                        height: dp(34)
                    BoxLayout:
                        id: caixa_integrantes
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(12)
        MiniPlayer:


# ======================================================================
# TELA: ALBUM - capa, título, artista, ano e as músicas que estão no app
# ======================================================================
# Linha de música do álbum:  Título / Artista  (a que está tocando fica vermelha)
<LinhaMusicaAlbum>:
    size_hint_y: None
    height: dp(66)
    padding: dp(8), dp(4)
    canvas.before:
        Color:
            rgba: (1, 1, 1, .08) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    BoxLayout:
        orientation: "vertical"
        Texto:
            text: root.titulo
            font_size: "20sp"
            valign: "bottom"
            color: COR_DESTAQUE if root.id_musica == app.id_atual else (1, 1, 1, 1)
        Texto:
            text: root.artista
            font_size: "15sp"
            valign: "top"
            color: COR_CINZA

<TelaAlbum>:
    BoxLayout:
        orientation: "vertical"
        ScrollView:
            id: rolagem
            do_scroll_x: False
            bar_width: 0
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(16), dp(14), dp(16), dp(24)
                spacing: dp(8)

                BotaoVoltar:
                    on_release: app.voltar_tela()

                # Capa grande e quadrada, centralizada (~70% da largura)
                BoxLayout:
                    size_hint_y: None
                    height: self.width * 0.69
                    padding: self.width * 0.155, 0
                    ImagemArredondada:
                        raio: dp(30)
                        source: root.capa

                # Título (quebra em mais linhas se o nome for grande)
                Label:
                    text: root.nome
                    bold: True
                    font_size: "28sp"
                    size_hint_y: None
                    text_size: self.width, None
                    height: self.texture_size[1] + dp(8)
                    halign: "left"
                    valign: "middle"

                # Fotinho redonda + nome do artista
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)
                    ImagemArredondada:
                        size_hint: None, None
                        size: dp(36), dp(36)
                        pos_hint: {"center_y": .5}
                        raio: dp(18)
                        source: root.logo
                    Texto:
                        text: root.artista
                        font_size: "24sp"
                        color: COR_CINZA

                Label:
                    text: root.lancamento
                    font_size: "14sp"
                    color: COR_CINZA
                    size_hint_y: None
                    height: dp(26) if root.lancamento else 0
                    text_size: self.width, None
                    halign: "left"
                    valign: "middle"
                    padding_x: dp(10)

                Widget:
                    size_hint_y: None
                    height: dp(14)

                # as músicas são criadas pelo main.py (TelaAlbum.carregar)
                BoxLayout:
                    id: caixa_musicas
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(6)

                Label:
                    text: "Nenhuma música deste álbum está no app."
                    font_size: "15sp"
                    color: COR_CINZA
                    size_hint_y: None
                    height: dp(60) if root.sem_musicas else 0
                    opacity: 1 if root.sem_musicas else 0
                    text_size: self.width, None
                    halign: "center"
                    valign: "middle"
        MiniPlayer:
